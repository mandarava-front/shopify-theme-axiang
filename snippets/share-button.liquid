{% comment %}
  Renders share button.
  Accepts:
  - block: {Object} passes in the block information.
  - share_link: {String} url to be added to the input the user will get/copy.

  Usage:
  {% render 'share-button',
    block: block,
    share_link: share_url
  %}
{% endcomment %}
<script src="{{ 'share.js' | asset_url }}" defer="defer"></script>
{%- assign encoded_share_link = share_link | url_encode -%}
{%- assign encoded_share_title = product.title | default: page_title | url_encode -%}

<share-button id="Share-{{ section.id }}" class="share-button quick-add-hidden" {{ block.shopify_attributes }}>
  <button class="share-button__button hidden">
    <span class="svg-wrapper">{{ 'icon-share.svg' | inline_asset_content }}</span>
    {{ block.settings.share_label | escape }}
  </button>
  <details id="Details-{{ block.id }}-{{ section.id }}">
    <summary class="share-button__button">
      <span class="svg-wrapper">{{ 'icon-share.svg' | inline_asset_content }}</span>
      {{ block.settings.share_label | escape }}
    </summary>
    <div class="share-button__fallback motion-reduce">
      <div class="share-button__socials" aria-label="Share options">
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_share_link }}" data-share-platform="facebook" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
          {{- 'icon-facebook.svg' | inline_asset_content -}}
        </a>
        <button type="button" data-native-share="tiktok" aria-label="Share on TikTok">
          {{- 'icon-tiktok.svg' | inline_asset_content -}}
        </button>
        <button type="button" data-native-share="instagram" aria-label="Share on Instagram">
          {{- 'icon-instagram.svg' | inline_asset_content -}}
        </button>
        <a href="https://twitter.com/intent/tweet?url={{ encoded_share_link }}&text={{ encoded_share_title }}" data-share-platform="x" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
          {{- 'icon-twitter.svg' | inline_asset_content -}}
        </a>
        <a href="https://pinterest.com/pin/create/button/?url={{ encoded_share_link }}&description={{ encoded_share_title }}" data-share-platform="pinterest" target="_blank" rel="noopener noreferrer" aria-label="Share on Pinterest">
          {{- 'icon-pinterest.svg' | inline_asset_content -}}
        </a>
        <a href="mailto:?subject={{ encoded_share_title }}&body={{ encoded_share_link }}" data-share-platform="email" aria-label="Share by email">
          {{- 'icon-email.svg' | inline_asset_content -}}
        </a>
      </div>
      <div class="field">
        <span id="ShareMessage-{{ section.id }}" class="share-button__message hidden" role="status"> </span>
        <input
          type="text"
          class="field__input"
          id="ShareUrl-{{ section.id }}"
          value="{{ share_link }}"
          placeholder="{{ 'general.share.share_url' | t }}"
          onclick="this.select();"
          readonly
        >
        <label class="field__label" for="ShareUrl-{{ section.id }}">{{ 'general.share.share_url' | t }}</label>
      </div>
      <button class="share-button__close hidden">
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">{{ 'general.share.close' | t }}</span>
      </button>
      <button class="share-button__copy">
        <span class="svg-wrapper">
          {{- 'icon-copy.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">{{ 'general.share.copy_to_clipboard' | t }}</span>
      </button>
    </div>
  </details>
</share-button>
