{{ 'judge-me-custom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'judge-me-custom.js' | asset_url }}" defer="defer"></script>

<judge-me-review-layout
  id="reviews"
  class="jdgm-custom-reviews jdgm-custom-reviews--{{ section.settings.layout_mode }} color-{{ section.settings.color_scheme }} gradient"
  data-layout="{{ section.settings.layout_mode }}"
  data-columns="{{ section.settings.columns_desktop }}"
  data-rows="{{ section.settings.rows_desktop }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-seconds="{{ section.settings.autoplay_seconds }}"
  style="--jdgm-review-columns: {{ section.settings.columns_desktop }}; --jdgm-review-radius: {{ section.settings.card_radius }}px;"
>
  <div class="page-width jdgm-custom-reviews__inner">
    <div class="jdgm-custom-reviews__header">
      <div>
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <a class="button button--secondary" href="{{ section.settings.view_all_link | default: '/pages/reviews' }}">
          {{ section.settings.view_all_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <!-- Judge.me supplies the genuine featured review content in this metafield. -->
    <div class="jdgm-carousel-wrapper" data-auto-install="false">
      {% assign jm_metafields = shop.metafields.judgeme %}
      <div class="jdgm-custom-reviews__summary">
        <span
          class="jdgm-all-reviews-rating"
          data-score="{{ jm_metafields.all_reviews_rating }}"
          aria-label="{{ jm_metafields.all_reviews_rating }} stars"
          role="img"
        ></span>
        <span>{{ jm_metafields.all_reviews_rating }} · {{ jm_metafields.all_reviews_count }} reviews</span>
      </div>
      {{ jm_metafields.featured_carousel }}
    </div>
  </div>
</judge-me-review-layout>

{% schema %}
{
  "name": "Judge.me 评论展示",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Happy Customers" },
    { "type": "text", "id": "subheading", "label": "副标题", "default": "Real reviews from our customers." },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "展示方式",
      "options": [
        { "value": "grid", "label": "多行网格" },
        { "value": "slider", "label": "左右滑动" },
        { "value": "carousel", "label": "按钮轮播" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "columns_desktop", "label": "电脑端每行数量", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "rows_desktop", "label": "网格行数", "min": 1, "max": 3, "step": 1, "default": 2, "info": "只在多行网格模式生效。" },
    { "type": "checkbox", "id": "autoplay", "label": "自动轮播", "default": false, "info": "只在按钮轮播模式生效。" },
    { "type": "range", "id": "autoplay_seconds", "label": "自动轮播间隔", "min": 3, "max": 10, "step": 1, "unit": "秒", "default": 5 },
    { "type": "range", "id": "card_radius", "label": "卡片圆角", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "显示 View all", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all 文字", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all 链接" },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Judge.me 评论展示" }]
}
{% endschema %}
