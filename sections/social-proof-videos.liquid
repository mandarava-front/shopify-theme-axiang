{{ 'cuszoo-experience.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <social-proof-slider id="reviews" class="page-width section-{{ section.id }}-padding cuszoo-social-proof">
    <div class="cuszoo-social-proof__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="cuszoo-section-heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="cuszoo-social-proof__slider">
      <button class="cuszoo-social-proof__arrow cuszoo-social-proof__arrow--prev" type="button" aria-label="Previous video">
        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
      </button>
      <div class="cuszoo-social-proof__rail" role="list" tabindex="0">
        <span class="cuszoo-social-proof__spacer" aria-hidden="true"></span>
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_product = block.settings.product
            assign card_title = block.settings.title | default: card_product.title
            assign card_link = block.settings.link | default: card_product.url | default: '#'
            assign card_poster = block.settings.poster_url
            if block.settings.poster != blank
              assign card_poster = block.settings.poster | image_url: width: 1200
            endif
          -%}
          <article class="cuszoo-video-card" role="listitem" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="cuszoo-video-card__media">
              {%- if block.settings.video != blank -%}
                {{
                  block.settings.video
                  | video_tag:
                    autoplay: false,
                    loop: true,
                    muted: true,
                    controls: false,
                    preload: 'metadata',
                    image_size: '800x'
                }}
              {%- elsif block.settings.video_url != blank -%}
                <video
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  tabindex="0"
                  {% if card_poster != blank %}poster="{{ card_poster }}"{% endif %}
                  aria-label="{{ card_title | escape }}. Select to pause or play."
                >
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                </video>
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- unless block.settings.platform == 'none' -%}
                <span class="cuszoo-video-card__platforms" aria-hidden="true">
                  {%- if block.settings.platform contains 'youtube' -%}
                    <span class="svg-wrapper">{{- 'icon-youtube.svg' | inline_asset_content -}}</span>
                  {%- endif -%}
                  {%- if block.settings.platform contains 'instagram' -%}
                    <span class="svg-wrapper">{{- 'icon-instagram.svg' | inline_asset_content -}}</span>
                  {%- endif -%}
                  {%- if block.settings.platform contains 'tiktok' -%}
                    <span class="svg-wrapper">{{- 'icon-tiktok.svg' | inline_asset_content -}}</span>
                  {%- endif -%}
                </span>
              {%- endunless -%}

              <a href="{{ card_link }}" class="cuszoo-video-card__overlay focus-inset">
                {%- if block.settings.thumbnail != blank -%}
                  {{ block.settings.thumbnail | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 120, 180', alt: card_title }}
                {%- elsif block.settings.thumbnail_url != blank -%}
                  <img src="{{ block.settings.thumbnail_url }}" alt="{{ card_title | escape }}" width="180" height="180" loading="lazy">
                {%- elsif card_product.featured_image != blank -%}
                  {{ card_product.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 120, 180', alt: card_title }}
                {%- endif -%}
                <span class="cuszoo-video-card__product-copy">
                  <strong title="{{ card_title | escape }}">{{ card_title | escape }}</strong>
                  {%- if card_product != blank -%}
                    <span class="cuszoo-video-card__price">{{ card_product.price | money }}</span>
                  {%- elsif block.settings.manual_price != blank -%}
                    <span class="cuszoo-video-card__price">{{ block.settings.manual_price | escape }}</span>
                  {%- endif -%}
                </span>
              </a>
            </div>
          </article>
        {%- endfor -%}
        <span class="cuszoo-social-proof__spacer" aria-hidden="true"></span>
      </div>
      <button class="cuszoo-social-proof__arrow cuszoo-social-proof__arrow--next" type="button" aria-label="Next video">
        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
      </button>
    </div>
  </social-proof-slider>
</div>

<script>
  if (!customElements.get('social-proof-slider')) {
    customElements.define('social-proof-slider', class extends HTMLElement {
      connectedCallback() {
        this.rail = this.querySelector('.cuszoo-social-proof__rail');
        this.cards = Array.from(this.querySelectorAll('.cuszoo-video-card'));
        const initialIndex = window.matchMedia('(min-width: 990px)').matches ? 2 : 1;
        this.activeIndex = Math.min(initialIndex, this.cards.length - 1);
        this.querySelector('.cuszoo-social-proof__arrow--prev').addEventListener('click', () => this.scroll(-1));
        this.querySelector('.cuszoo-social-proof__arrow--next').addEventListener('click', () => this.scroll(1));
        this.cards.forEach((card, index) => {
          const video = card.querySelector('video');
          if (!video) return;
          const toggle = () => video.paused ? video.play() : video.pause();
          video.addEventListener('click', (event) => {
            if (index !== this.activeIndex) {
              event.preventDefault();
              this.goTo(index);
              return;
            }
            toggle();
          });
          video.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              index === this.activeIndex ? toggle() : this.goTo(index);
            }
          });
        });

        let frame;
        this.rail.addEventListener('scroll', () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => this.updateActive());
        }, { passive: true });

        window.addEventListener('resize', () => this.goTo(this.activeIndex, 'auto'));
        requestAnimationFrame(() => requestAnimationFrame(() => this.goTo(this.activeIndex, 'auto')));
      }

      scroll(direction) {
        if (!this.cards.length) return;
        this.goTo((this.activeIndex + direction + this.cards.length) % this.cards.length);
      }

      goTo(index, behavior = 'smooth') {
        const card = this.cards[index];
        if (!card) return;
        this.activeIndex = index;
        const railRect = this.rail.getBoundingClientRect();
        const cardRect = card.getBoundingClientRect();
        this.rail.scrollTo({
          left: this.rail.scrollLeft + cardRect.left - railRect.left - (this.rail.clientWidth - cardRect.width) / 2,
          behavior,
        });
        this.setActive(index);
      }

      updateActive() {
        const railRect = this.rail.getBoundingClientRect();
        const center = railRect.left + railRect.width / 2;
        let closestIndex = 0;
        let closestDistance = Infinity;
        this.cards.forEach((card, index) => {
          const cardRect = card.getBoundingClientRect();
          const distance = Math.abs(cardRect.left + cardRect.width / 2 - center);
          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });
        this.setActive(closestIndex);
      }

      setActive(index) {
        this.activeIndex = index;
        this.cards.forEach((card, cardIndex) => {
          const active = cardIndex === index;
          card.classList.toggle('is-active', active);
          card.setAttribute('aria-current', active ? 'true' : 'false');
          const video = card.querySelector('video');
          if (!video) return;
          active ? video.play().catch(() => {}) : video.pause();
        });
      }
    });
  }
</script>

{% schema %}
{
  "name": "社交证明视频",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Discover us on social media" },
    { "type": "text", "id": "subheading", "label": "副标题" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "标题大小",
      "options": [
        { "value": "h2", "label": "小" },
        { "value": "h1", "label": "中" }
      ],
      "default": "h1"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "上边距", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "下边距", "default": 40 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "视频关联产品",
      "settings": [
        { "type": "video", "id": "video", "label": "视频" },
        { "type": "url", "id": "video_url", "label": "外部 MP4 链接", "info": "仅在未选择 Shopify 托管视频时使用。" },
        { "type": "image_picker", "id": "poster", "label": "外部视频封面" },
        { "type": "url", "id": "poster_url", "label": "外部封面图链接" },
        { "type": "image_picker", "id": "thumbnail", "label": "产品缩略图" },
        { "type": "url", "id": "thumbnail_url", "label": "外部缩略图链接" },
        { "type": "product", "id": "product", "label": "产品" },
        { "type": "text", "id": "title", "label": "自定义标题" },
        { "type": "text", "id": "manual_price", "label": "手动价格", "info": "仅在未选择 Shopify 产品时使用。" },
        { "type": "url", "id": "link", "label": "自定义链接" },
        {
          "type": "select",
          "id": "platform",
          "label": "社交图标",
          "options": [
            { "value": "youtube_tiktok", "label": "YouTube 和 TikTok" },
            { "value": "instagram_tiktok", "label": "Instagram 和 TikTok" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "none", "label": "无" }
          ],
          "default": "instagram_tiktok"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "社交证明视频",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
