{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'cuszoo-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_banner = section.settings.banner_image_desktop
  assign mobile_banner = section.settings.banner_image_mobile | default: desktop_banner
  if desktop_banner == blank
    assign desktop_banner = mobile_banner
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .collection-hero__title {
    font-size: {{ section.settings.title_size }}px;
  }

  #shopify-section-{{ section.id }} .collection-hero__inner {
    padding-top: {{ section.settings.title_vertical_spacing }}px;
    padding-bottom: {{ section.settings.title_vertical_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

<div class="cuszoo-collection-header">
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="cuszoo-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_label | escape }}</a>
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        <span aria-current="page">{{ collection.title | escape }}</span>
      </nav>
    {%- endif -%}
  </div>

  {%- if desktop_banner != blank -%}
    <div class="cuszoo-collection-banner page-width">
      <picture>
        {%- if mobile_banner != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_banner | image_url: width: 375 }} 375w, {{ mobile_banner | image_url: width: 550 }} 550w, {{ mobile_banner | image_url: width: 750 }} 750w"
            sizes="100vw"
          >
        {%- endif -%}
        <img
          src="{{ desktop_banner | image_url: width: 1920 }}"
          srcset="{{ desktop_banner | image_url: width: 960 }} 960w, {{ desktop_banner | image_url: width: 1440 }} 1440w, {{ desktop_banner | image_url: width: 1920 }} 1920w, {{ desktop_banner | image_url: width: 2400 }} 2400w"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width }}px, 100vw"
          alt="{{ section.settings.banner_alt | default: desktop_banner.alt | escape }}"
          width="{{ desktop_banner.width }}"
          height="{{ desktop_banner.height }}"
          loading="eager"
          fetchpriority="high"
        >
      </picture>
    </div>
  {%- endif -%}

  <div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
    <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <div class="collection-hero__text-wrapper">
      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "显示面包屑导航"
    },
    {
      "type": "text",
      "id": "breadcrumb_home_label",
      "default": "Home",
      "label": "面包屑首页文字"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "image_picker",
      "id": "banner_image_desktop",
      "label": "电脑端横幅（建议 1920 × 400，比例 24:5）"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "手机端横幅（建议 750 × 500，比例 3:2）"
    },
    {
      "type": "text",
      "id": "banner_alt",
      "label": "横幅图片替代文字"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "系列标题字号",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_vertical_spacing",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "系列标题上下留白",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
