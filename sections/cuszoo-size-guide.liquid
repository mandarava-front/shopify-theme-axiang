{{ 'cuszoo-guide.css' | asset_url | stylesheet_tag }}

<div class="cuszoo-guide">
  <div class="page-width cuszoo-guide__inner">
    <header class="cuszoo-guide__header">
      {% if section.settings.eyebrow != blank %}<p class="cuszoo-guide__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1 class="cuszoo-guide__title">{{ section.settings.heading }}</h1>{% endif %}
      {% if section.settings.intro != blank %}<p class="cuszoo-guide__intro">{{ section.settings.intro }}</p>{% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="cuszoo-guide__grid">
        {% for block in section.blocks %}
          {% liquid
            assign fallback_asset = blank
            case forloop.index
              when 1
                assign fallback_asset = 'cuszoo-size-guide-hoodie.webp'
              when 2
                assign fallback_asset = 'cuszoo-size-guide-tshirt.webp'
            endcase
          %}
          <article class="cuszoo-guide__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: block.settings.image_alt }}
            {% elsif fallback_asset != blank %}
              <img src="{{ fallback_asset | asset_url }}" width="800" height="800" loading="lazy" alt="{{ block.settings.image_alt }}">
            {% endif %}
            <div class="cuszoo-guide__card-copy">
              {% if block.settings.title != blank %}<h2>{{ block.settings.title }}</h2>{% endif %}
              {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.note_heading != blank or section.settings.note_text != blank %}
      <div class="cuszoo-guide__note">
        {% if section.settings.note_heading != blank %}<strong>{{ section.settings.note_heading }}</strong>{% endif %}
        {% if section.settings.note_text != blank %}{{ section.settings.note_text }}{% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Cuszoo Size Guide",
  "tag": "section",
  "class": "section section--cuszoo-size-guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SIZE GUIDE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose Your Best Fit" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Use the chart for the garment style you are ordering. Measurements are taken by hand, so a small difference is possible." },
    { "type": "text", "id": "note_heading", "label": "Note heading", "default": "How to measure:" },
    { "type": "richtext", "id": "note_text", "label": "Note text", "default": "<p>Measure a similar garment flat, without stretching it. If you are between sizes, compare the chart with your favorite fit and choose the closest match. If you have a fuller build, we recommend choosing one size up for a more comfortable fit. Because each item is made to order, please confirm your size before checkout.</p>" }
  ],
  "blocks": [
    {
      "type": "chart",
      "name": "Size chart",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Size chart image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Size chart" },
        { "type": "text", "id": "title", "label": "Chart title", "default": "Size chart title" },
        { "type": "textarea", "id": "text", "label": "Chart description", "default": "Add measuring guidance for this garment." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size Guide",
      "blocks": [
        { "type": "chart", "settings": { "title": "Crewneck / Hoodie", "text": "Compare the length, width, and sleeve measurements with a similar garment you already own.", "image_alt": "Cuszoo crewneck and hoodie size chart" } },
        { "type": "chart", "settings": { "title": "Standard T-Shirt", "text": "Lay a similar T-shirt flat and check the length, width, and sleeve before choosing your size.", "image_alt": "Cuszoo standard T-shirt size chart" } }
      ]
    }
  ]
}
{% endschema %}
