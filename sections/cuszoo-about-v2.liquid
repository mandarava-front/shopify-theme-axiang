{{ 'cuszoo-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_block = section.blocks | where: 'type', 'hero' | first
  assign story_block = section.blocks | where: 'type', 'story' | first
  assign process_header = section.blocks | where: 'type', 'process_header' | first
  assign connections_header = section.blocks | where: 'type', 'connections_header' | first
  assign commitments_header = section.blocks | where: 'type', 'commitments_header' | first
  assign final_block = section.blocks | where: 'type', 'final' | first
-%}

<div class="cuszoo-about color-{{ section.settings.color_scheme }} gradient">
  {%- if hero_block != blank -%}
    <section class="cuszoo-about__hero" aria-labelledby="CuszooAboutHero-{{ section.id }}" {{ hero_block.shopify_attributes }}>
      <div class="page-width cuszoo-about__hero-inner">
        <div class="cuszoo-about__hero-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if hero_block.settings.eyebrow != blank -%}<p class="cuszoo-about__eyebrow">{{ hero_block.settings.eyebrow | escape }}</p>{%- endif -%}
          <h1 id="CuszooAboutHero-{{ section.id }}" class="cuszoo-about__hero-title">{{ hero_block.settings.heading }}</h1>
          {%- if hero_block.settings.text != blank -%}<div class="cuszoo-about__hero-text rte">{{ hero_block.settings.text }}</div>{%- endif -%}
          {%- if hero_block.settings.button_label != blank -%}
            <a class="button button--primary" href="{{ hero_block.settings.button_link | default: routes.all_products_collection_url }}">{{ hero_block.settings.button_label | escape }}</a>
          {%- endif -%}
        </div>
        <figure class="cuszoo-about__hero-media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
          {%- if hero_block.settings.image != blank -%}
            {{ hero_block.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 42vw, 92vw', loading: 'eager', fetchpriority: 'high', alt: hero_block.settings.image_alt }}
          {%- else -%}
            <img src="{{ 'cuszoo-about-hero-process.webp' | asset_url }}" width="1254" height="1254" loading="eager" fetchpriority="high" alt="{{ hero_block.settings.image_alt | escape }}">
          {%- endif -%}
        </figure>
      </div>
    </section>
  {%- endif -%}

  {%- if story_block != blank -%}
    <section class="cuszoo-about__section cuszoo-about__story" aria-labelledby="CuszooAboutStory-{{ section.id }}" {{ story_block.shopify_attributes }}>
      <div class="page-width cuszoo-about__inner cuszoo-about__story-grid">
        <div class="cuszoo-about__story-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if story_block.settings.eyebrow != blank -%}<p class="cuszoo-about__eyebrow">{{ story_block.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 id="CuszooAboutStory-{{ section.id }}" class="cuszoo-about__heading">{{ story_block.settings.heading }}</h2>
          <div class="cuszoo-about__body rte">{{ story_block.settings.text }}</div>
        </div>
        <div class="cuszoo-about__story-media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
          {%- for image_index in (1..4) -%}
            {%- liquid
              capture image_key
                echo 'image_' | append: image_index
              endcapture
              capture alt_key
                echo 'image_' | append: image_index | append: '_alt'
              endcapture
              assign story_image = story_block.settings[image_key]
              assign fallback_asset = 'cuszoo-about-story-main.webp'
              assign fallback_width = 1254
              assign fallback_height = 1254
              if image_index == 2
                assign fallback_asset = 'cuszoo-about-story-small-1.webp'
                assign fallback_width = 900
                assign fallback_height = 900
              elsif image_index == 3
                assign fallback_asset = 'cuszoo-about-story-small-2.webp'
                assign fallback_width = 567
                assign fallback_height = 756
              elsif image_index == 4
                assign fallback_asset = 'cuszoo-about-story-small-3.webp'
                assign fallback_width = 788
                assign fallback_height = 1400
              endif
            -%}
            <figure class="cuszoo-about__story-image cuszoo-about__story-image--{{ image_index }}">
              {%- if story_image != blank -%}
                {{ story_image | image_url: width: 1200 | image_tag: widths: '300, 500, 700, 900, 1200', sizes: '(min-width: 990px) 34vw, 70vw', loading: 'lazy', alt: story_block.settings[alt_key] }}
              {%- else -%}
                <img src="{{ fallback_asset | asset_url }}" width="{{ fallback_width }}" height="{{ fallback_height }}" loading="lazy" alt="{{ story_block.settings[alt_key] | escape }}">
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if process_header != blank -%}
    <section class="cuszoo-about__section cuszoo-about__process" aria-labelledby="CuszooAboutProcess-{{ section.id }}">
      <div class="page-width cuszoo-about__inner">
        <div class="cuszoo-about__section-header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ process_header.shopify_attributes }}>
          {%- if process_header.settings.eyebrow != blank -%}<p class="cuszoo-about__eyebrow">{{ process_header.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 id="CuszooAboutProcess-{{ section.id }}" class="cuszoo-about__heading">{{ process_header.settings.heading }}</h2>
          {%- if process_header.settings.text != blank -%}<p class="cuszoo-about__intro">{{ process_header.settings.text | escape }}</p>{%- endif -%}
        </div>
        <ol class="cuszoo-about__steps" role="list">
          {%- assign process_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'process_step' -%}
              {%- assign process_index = process_index | plus: 1 -%}
              <li class="cuszoo-about__step{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"{% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ process_index }};"{% endif %} {{ block.shopify_attributes }}>
                <span class="cuszoo-about__step-number" aria-hidden="true">{{ process_index | prepend: '0' | slice: -2, 2 }}</span>
                <h3>{{ block.settings.heading | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}

  {%- if connections_header != blank -%}
    <section class="cuszoo-about__section cuszoo-about__connections" aria-labelledby="CuszooAboutConnections-{{ section.id }}">
      <div class="page-width cuszoo-about__inner">
        <div class="cuszoo-about__section-header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ connections_header.shopify_attributes }}>
          {%- if connections_header.settings.eyebrow != blank -%}<p class="cuszoo-about__eyebrow">{{ connections_header.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 id="CuszooAboutConnections-{{ section.id }}" class="cuszoo-about__heading">{{ connections_header.settings.heading }}</h2>
          {%- if connections_header.settings.text != blank -%}<p class="cuszoo-about__intro">{{ connections_header.settings.text | escape }}</p>{%- endif -%}
        </div>
        <div class="cuszoo-about__connection-grid" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'connection' -%}
              <article class="cuszoo-about__connection{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" role="listitem" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="cuszoo-about__connection-link focus-inset">
                  <div class="cuszoo-about__connection-media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 900 | image_tag: widths: '350, 500, 700, 900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 86vw', loading: 'lazy', alt: block.settings.image_alt }}
                    {%- elsif block.settings.use_memory_fallback -%}
                      <img src="{{ 'cuszoo-about-connection-memories.webp' | asset_url }}" width="524" height="713" loading="lazy" alt="{{ block.settings.image_alt | escape }}">
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div class="cuszoo-about__connection-copy">
                    <h3>{{ block.settings.heading | escape }}</h3>
                    <p>{{ block.settings.text | escape }}</p>
                    <span class="cuszoo-about__connection-action">{{ block.settings.link_label | escape }}<span class="material-icons-round" aria-hidden="true">arrow_forward</span></span>
                  </div>
                </a>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if commitments_header != blank -%}
    <section class="cuszoo-about__section cuszoo-about__commitments" aria-labelledby="CuszooAboutCommitments-{{ section.id }}">
      <div class="page-width cuszoo-about__inner cuszoo-about__commitments-inner">
        <div class="cuszoo-about__commitments-heading{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ commitments_header.shopify_attributes }}>
          {%- if commitments_header.settings.eyebrow != blank -%}<p class="cuszoo-about__eyebrow cuszoo-about__eyebrow--light">{{ commitments_header.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 id="CuszooAboutCommitments-{{ section.id }}" class="cuszoo-about__heading">{{ commitments_header.settings.heading }}</h2>
        </div>
        <div class="cuszoo-about__commitment-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'commitment' -%}
              <div class="cuszoo-about__commitment{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" role="listitem" {{ block.shopify_attributes }}>
                {%- render 'material-icon', custom_icon: block.settings.icon, class: 'cuszoo-about__commitment-icon' -%}
                <div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if final_block != blank -%}
    <section class="cuszoo-about__final" aria-labelledby="CuszooAboutFinal-{{ section.id }}" {{ final_block.shopify_attributes }}>
      <div class="cuszoo-about__final-media">
        {%- if final_block.settings.image != blank -%}
          {{ final_block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'lazy', alt: final_block.settings.image_alt }}
        {%- else -%}
          <img src="{{ 'cuszoo-about-final-process.webp' | asset_url }}" width="1500" height="664" loading="lazy" alt="{{ final_block.settings.image_alt | escape }}">
        {%- endif -%}
      </div>
      <div class="cuszoo-about__final-shade" aria-hidden="true"></div>
      <div class="page-width cuszoo-about__final-inner">
        <div class="cuszoo-about__final-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <h2 id="CuszooAboutFinal-{{ section.id }}">{{ final_block.settings.heading }}</h2>
          {%- if final_block.settings.text != blank -%}<p>{{ final_block.settings.text | escape }}</p>{%- endif -%}
          <div class="cuszoo-about__final-actions">
            {%- if final_block.settings.button_label != blank -%}<a class="button button--primary" href="{{ final_block.settings.button_link | default: routes.all_products_collection_url }}">{{ final_block.settings.button_label | escape }}</a>{%- endif -%}
            {%- if final_block.settings.secondary_label != blank -%}<a class="cuszoo-about__text-link" href="{{ final_block.settings.secondary_link | default: routes.root_url }}">{{ final_block.settings.secondary_label | escape }}<span class="material-icons-round" aria-hidden="true">arrow_forward</span></a>{%- endif -%}
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cuszoo About Us 可编辑版",
  "tag": "section",
  "class": "section section--cuszoo-about",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "页面配色", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "首屏：文字 + 制作图",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "右侧 1:1 图片" },
        { "type": "text", "id": "image_alt", "label": "图片替代文字", "default": "A personalized embroidered gift being made" },
        { "type": "text", "id": "eyebrow", "label": "小标题", "default": "ABOUT CUSZOO" },
        { "type": "inline_richtext", "id": "heading", "label": "标题", "default": "Made Personal. Kept Forever." },
        { "type": "richtext", "id": "text", "label": "介绍", "default": "<p>We turn the people, pets, and moments you love into gifts made to feel unmistakably yours.</p>" },
        { "type": "text", "id": "button_label", "label": "按钮文字", "default": "Explore Personalized Gifts" },
        { "type": "url", "id": "button_link", "label": "按钮链接" }
      ]
    },
    {
      "type": "story",
      "name": "Our Story 图文拼贴",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "小标题", "default": "OUR STORY" },
        { "type": "inline_richtext", "id": "heading", "label": "标题", "default": "Small Details. Big Meaning." },
        { "type": "richtext", "id": "text", "label": "正文", "default": "<p>The best gifts begin with something real: a favorite photo, a familiar name, or a moment you never want to lose.</p><p>At Cuszoo, we help turn those details into personal keepsakes made for celebrating, remembering, and staying connected.</p>" },
        { "type": "image_picker", "id": "image_1", "label": "大图（默认人物 1-1）" },
        { "type": "text", "id": "image_1_alt", "label": "大图替代文字", "default": "Customer holding personalized gifts" },
        { "type": "image_picker", "id": "image_2", "label": "小图 1（默认人物 2）" },
        { "type": "text", "id": "image_2_alt", "label": "小图 1 替代文字", "default": "Customer wearing a personalized shirt" },
        { "type": "image_picker", "id": "image_3", "label": "小图 2（默认人物 2.）" },
        { "type": "text", "id": "image_3_alt", "label": "小图 2 替代文字", "default": "Customer wearing a personalized hat" },
        { "type": "image_picker", "id": "image_4", "label": "小图 3（默认人物 5）" },
        { "type": "text", "id": "image_4_alt", "label": "小图 3 替代文字", "default": "Customer carrying a personalized pet bag" }
      ]
    },
    {
      "type": "process_header",
      "name": "制作流程标题",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "小标题", "default": "FROM MEMORY TO GIFT" },
        { "type": "inline_richtext", "id": "heading", "label": "标题", "default": "Your Story, Made Tangible" },
        { "type": "text", "id": "text", "label": "介绍", "default": "A few personal details are all it takes to begin." }
      ]
    },
    {
      "type": "process_step",
      "name": "制作流程步骤",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "heading", "label": "标题", "default": "Start With Your Story" },
        { "type": "textarea", "id": "text", "label": "文字", "default": "Choose a photo, name, message, or meaningful detail." }
      ]
    },
    {
      "type": "connections_header",
      "name": "关系分类标题",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "小标题", "default": "MADE FOR WHAT MATTERS" },
        { "type": "inline_richtext", "id": "heading", "label": "标题", "default": "For Every Meaningful Connection" },
        { "type": "text", "id": "text", "label": "介绍", "default": "Find something personal for the relationships and memories closest to you." }
      ]
    },
    {
      "type": "connection",
      "name": "关系分类卡片",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "checkbox", "id": "use_memory_fallback", "label": "使用人物 2-1 默认图片", "default": false },
        { "type": "text", "id": "image_alt", "label": "图片替代文字" },
        { "type": "text", "id": "heading", "label": "标题", "default": "For the Pets We Love" },
        { "type": "textarea", "id": "text", "label": "文字", "default": "Personal gifts celebrating the bond that makes every day brighter." },
        { "type": "text", "id": "link_label", "label": "链接文字", "default": "Explore gifts" },
        { "type": "url", "id": "link", "label": "链接" }
      ]
    },
    {
      "type": "commitments_header",
      "name": "品牌承诺标题",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "小标题", "default": "THE CUSZOO PROMISE" },
        { "type": "inline_richtext", "id": "heading", "label": "标题", "default": "Thoughtful From Start to Finish" }
      ]
    },
    {
      "type": "commitment",
      "name": "品牌承诺条目",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "icon", "label": "Google 图标名称", "default": "volunteer_activism" },
        { "type": "text", "id": "heading", "label": "标题", "default": "Meaningful by Design" },
        { "type": "textarea", "id": "text", "label": "文字", "default": "Personal details are part of the design, not an afterthought." }
      ]
    },
    {
      "type": "final",
      "name": "底部行动区",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "长条背景图" },
        { "type": "text", "id": "image_alt", "label": "图片替代文字", "default": "A personalized gift being crafted" },
        { "type": "inline_richtext", "id": "heading", "label": "标题", "default": "Your Favorite Moment Already Means Everything." },
        { "type": "text", "id": "text", "label": "文字", "default": "Let’s make it something you can keep." },
        { "type": "text", "id": "button_label", "label": "主按钮文字", "default": "Find Your Gift" },
        { "type": "url", "id": "button_link", "label": "主按钮链接" },
        { "type": "text", "id": "secondary_label", "label": "次要链接文字", "default": "Need help? Contact us" },
        { "type": "url", "id": "secondary_link", "label": "次要链接" }
      ]
    }
  ],
  "max_blocks": 32,
  "presets": [
    {
      "name": "Cuszoo About Us 可编辑版",
      "blocks": [
        { "type": "hero" },
        { "type": "story" },
        { "type": "process_header" },
        { "type": "process_step" },
        { "type": "process_step" },
        { "type": "process_step" },
        { "type": "connections_header" },
        { "type": "connection" },
        { "type": "connection" },
        { "type": "connection" },
        { "type": "connection" },
        { "type": "commitments_header" },
        { "type": "commitment" },
        { "type": "commitment" },
        { "type": "commitment" },
        { "type": "final" }
      ]
    }
  ]
}
{% endschema %}
