{{ 'gift-finder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-finder.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<gift-finder
  class="gift-finder color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-search-url="{{ routes.search_url }}"
>
  <div class="gift-finder__inner page-width">
    <header class="gift-finder__header">
      <span class="gift-finder__icon material-icons-round" aria-hidden="true">redeem</span>
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </header>

    <form class="gift-finder__form" data-gift-finder-form>
      <fieldset class="gift-finder__step">
        <legend><span>1</span>{{ section.settings.recipient_heading | escape }}</legend>
        <div class="gift-finder__options">
          {%- for block in section.blocks -%}
            {%- if block.type == 'recipient' -%}
              <label class="gift-finder__option" {{ block.shopify_attributes }}>
                <input
                  type="radio"
                  name="recipient-{{ section.id }}"
                  value="{{ block.settings.filter_tag | default: block.settings.title | escape }}"
                  data-gift-finder-option="recipient"
                >
                <span class="gift-finder__option-card">
                  <span class="gift-finder__option-media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '180, 300, 500', alt: block.settings.title }}
                    {%- else -%}
                      <span class="material-icons-round" aria-hidden="true">person</span>
                    {%- endif -%}
                  </span>
                  <span class="gift-finder__option-title">{{ block.settings.title | escape }}</span>
                </span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </fieldset>

      <fieldset class="gift-finder__step">
        <legend><span>2</span>{{ section.settings.occasion_heading | escape }}</legend>
        <div class="gift-finder__options">
          {%- for block in section.blocks -%}
            {%- if block.type == 'occasion' -%}
              <label class="gift-finder__option" {{ block.shopify_attributes }}>
                <input
                  type="radio"
                  name="occasion-{{ section.id }}"
                  value="{{ block.settings.filter_tag | default: block.settings.title | escape }}"
                  data-gift-finder-option="occasion"
                >
                <span class="gift-finder__option-card">
                  <span class="gift-finder__option-media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '180, 300, 500', alt: block.settings.title }}
                    {%- else -%}
                      <span class="material-icons-round" aria-hidden="true">celebration</span>
                    {%- endif -%}
                  </span>
                  <span class="gift-finder__option-title">{{ block.settings.title | escape }}</span>
                </span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </fieldset>

      <div class="gift-finder__actions">
        <button class="button" type="submit" disabled data-gift-finder-submit>
          {{ section.settings.button_label | escape }}
          <span class="material-icons-round" aria-hidden="true">arrow_forward</span>
        </button>
        <button class="gift-finder__reset link underlined-link" type="reset">{{ section.settings.reset_label | escape }}</button>
      </div>
    </form>
  </div>
</gift-finder>

{% schema %}
{
  "name": "礼物查找器",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Gift Finder" },
    { "type": "text", "id": "text", "label": "介绍文字", "default": "Find a thoughtful personalized gift in seconds." },
    { "type": "text", "id": "recipient_heading", "label": "收礼人问题", "default": "Who are you gifting for?" },
    { "type": "text", "id": "occasion_heading", "label": "场合问题", "default": "What's the occasion?" },
    { "type": "text", "id": "button_label", "label": "结果按钮", "default": "See top picks" },
    { "type": "text", "id": "reset_label", "label": "重置按钮", "default": "Start over" },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "scheme-1" },
    { "type": "header", "content": "模块间距" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "上边距", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "下边距", "default": 64 }
  ],
  "blocks": [
    {
      "type": "recipient",
      "name": "收礼人",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "title", "label": "文字", "default": "For him" },
        { "type": "text", "id": "filter_tag", "label": "用于筛选结果的产品标签", "default": "Him" }
      ]
    },
    {
      "type": "occasion",
      "name": "场合",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "title", "label": "文字", "default": "Birthday" },
        { "type": "text", "id": "filter_tag", "label": "用于筛选结果的产品标签", "default": "Birthday" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "礼物查找器",
      "blocks": [
        { "type": "recipient", "settings": { "title": "For him", "filter_tag": "Him" } },
        { "type": "recipient", "settings": { "title": "For her", "filter_tag": "Her" } },
        { "type": "recipient", "settings": { "title": "Pet lover", "filter_tag": "Pets" } },
        { "type": "recipient", "settings": { "title": "Parents", "filter_tag": "Parents" } },
        { "type": "recipient", "settings": { "title": "Dad", "filter_tag": "Dads" } },
        { "type": "recipient", "settings": { "title": "Mom", "filter_tag": "Moms" } },
        { "type": "recipient", "settings": { "title": "Kids", "filter_tag": "Kids" } },
        { "type": "recipient", "settings": { "title": "Couple", "filter_tag": "Couples" } },
        { "type": "occasion", "settings": { "title": "Just because", "filter_tag": "Just Because" } },
        { "type": "occasion", "settings": { "title": "Birthday", "filter_tag": "Birthday" } },
        { "type": "occasion", "settings": { "title": "Halloween", "filter_tag": "Halloween" } },
        { "type": "occasion", "settings": { "title": "Anniversary", "filter_tag": "Anniversary" } },
        { "type": "occasion", "settings": { "title": "Wedding", "filter_tag": "Wedding" } },
        { "type": "occasion", "settings": { "title": "Christmas", "filter_tag": "Christmas" } },
        { "type": "occasion", "settings": { "title": "Graduation", "filter_tag": "Graduation" } },
        { "type": "occasion", "settings": { "title": "Memorial", "filter_tag": "Memorial" } }
      ]
    }
  ]
}
{% endschema %}
