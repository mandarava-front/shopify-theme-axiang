{{ 'cuszoo-guide.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .cuszoo-home-steps {
    background: {{ section.settings.background | default: '#fbf6ef' }};
  }
{%- endstyle -%}

<section class="cuszoo-home-steps">
  <div class="page-width">
    {% if section.settings.heading != blank %}<h2 class="cuszoo-home-steps__heading">{{ section.settings.heading }}</h2>{% endif %}
    <div class="cuszoo-home-steps__grid">
      {% for block in section.blocks %}
        <article class="cuszoo-home-steps__item" {{ block.shopify_attributes }}>
          {% assign image = block.settings.image %}
          {% assign image_small = blank %}
          {% case block.settings.image %}
            {% when 'cuszoo-personalization-1.webp' %}
              {% assign image_small = 'cuszoo-personalization-1-400.webp' %}
            {% when 'cuszoo-personalization-2.webp' %}
              {% assign image_small = 'cuszoo-personalization-2-400.webp' %}
            {% when 'cuszoo-personalization-3.webp' %}
              {% assign image_small = 'cuszoo-personalization-3-400.webp' %}
            {% when 'cuszoo-personalization-4.webp' %}
              {% assign image_small = 'cuszoo-personalization-4-400.webp' %}
          {% endcase %}
          {% if image != blank or block.settings.image != blank %}
            <div class="cuszoo-home-steps__media">
              {% if image != blank %}
                {{ image | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: block.settings.image_alt }}
              {% else %}
                <img
                  {% if image_small != blank %}
                    srcset="{{ image_small | asset_url }} 400w, {{ block.settings.image | asset_url }} 800w"
                    sizes="(min-width: 750px) 25vw, 50vw"
                  {% endif %}
                  src="{{ block.settings.image | asset_url }}"
                  width="800"
                  height="800"
                  loading="lazy"
                  alt="{{ block.settings.image_alt | escape }}"
                >
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Personalization steps",
  "tag": "section",
  "class": "section section--cuszoo-home-steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for your story" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fbf6ef" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Personalization step" },
        { "type": "text", "id": "text", "label": "Short caption", "default": "Your memories, made personal." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Personalization steps",
      "blocks": [
        { "type": "step", "settings": { "text": "Choose a photo you love." } },
        { "type": "step", "settings": { "text": "We turn it into your design." } },
        { "type": "step", "settings": { "text": "We make it with care." } },
        { "type": "step", "settings": { "text": "Then we ship it to you." } }
      ]
    }
  ]
}
{% endschema %}
