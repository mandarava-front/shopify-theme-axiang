{{ 'cuszoo-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.hero_image
  if hero_image == blank
    assign hero_image = section.settings.hero_image_mobile
  endif

  assign final_image = section.settings.final_image
-%}

<div class="cuszoo-about color-{{ section.settings.color_scheme }} gradient">
  <section class="cuszoo-about__hero" aria-labelledby="CuszooAboutHero-{{ section.id }}">
    <div class="cuszoo-about__hero-media">
      {%- if hero_image != blank -%}
        <picture>
          {%- if section.settings.hero_image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.hero_image_mobile | image_url: width: 550 }} 550w,
                {{ section.settings.hero_image_mobile | image_url: width: 900 }} 900w,
                {{ section.settings.hero_image_mobile | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 2000, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.hero_image_alt
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="cuszoo-about__hero-shade" aria-hidden="true"></div>
    <div class="page-width cuszoo-about__hero-inner">
      <div class="cuszoo-about__hero-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.hero_eyebrow != blank -%}
          <p class="cuszoo-about__eyebrow cuszoo-about__eyebrow--light">{{ section.settings.hero_eyebrow | escape }}</p>
        {%- endif -%}
        <h1 id="CuszooAboutHero-{{ section.id }}" class="cuszoo-about__hero-title">{{ section.settings.hero_heading }}</h1>
        {%- if section.settings.hero_text != blank -%}
          <div class="cuszoo-about__hero-text rte">{{ section.settings.hero_text }}</div>
        {%- endif -%}
        {%- if section.settings.hero_button_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.hero_button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.hero_button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="cuszoo-about__section cuszoo-about__story" aria-labelledby="CuszooAboutStory-{{ section.id }}">
    <div class="page-width cuszoo-about__inner cuszoo-about__story-grid">
      <div class="cuszoo-about__story-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.story_eyebrow != blank -%}
          <p class="cuszoo-about__eyebrow">{{ section.settings.story_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="CuszooAboutStory-{{ section.id }}" class="cuszoo-about__heading">{{ section.settings.story_heading }}</h2>
        <div class="cuszoo-about__body rte">{{ section.settings.story_text }}</div>
      </div>
      <div class="cuszoo-about__story-media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        <figure class="cuszoo-about__story-image cuszoo-about__story-image--primary">
          {%- if section.settings.story_image_primary != blank -%}
            {{
              section.settings.story_image_primary
              | image_url: width: 1000
              | image_tag:
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 990px) 34vw, 70vw',
                loading: 'lazy',
                alt: section.settings.story_image_primary_alt
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </figure>
        <figure class="cuszoo-about__story-image cuszoo-about__story-image--secondary">
          {%- if section.settings.story_image_secondary != blank -%}
            {{
              section.settings.story_image_secondary
              | image_url: width: 800
              | image_tag:
                widths: '300, 500, 700, 800',
                sizes: '(min-width: 990px) 20vw, 42vw',
                loading: 'lazy',
                alt: section.settings.story_image_secondary_alt
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </figure>
      </div>
    </div>
  </section>

  <section class="cuszoo-about__section cuszoo-about__process" aria-labelledby="CuszooAboutProcess-{{ section.id }}">
    <div class="page-width cuszoo-about__inner">
      <div class="cuszoo-about__section-header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.process_eyebrow != blank -%}
          <p class="cuszoo-about__eyebrow">{{ section.settings.process_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="CuszooAboutProcess-{{ section.id }}" class="cuszoo-about__heading">{{ section.settings.process_heading }}</h2>
        {%- if section.settings.process_text != blank -%}
          <p class="cuszoo-about__intro">{{ section.settings.process_text | escape }}</p>
        {%- endif -%}
      </div>
      <ol class="cuszoo-about__steps" role="list">
        {%- for index in (1..3) -%}
          {%- liquid
            capture heading_key
              echo 'step_' | append: index | append: '_heading'
            endcapture
            capture text_key
              echo 'step_' | append: index | append: '_text'
            endcapture
          -%}
          <li class="cuszoo-about__step{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"{% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ index }};"{% endif %}>
            <span class="cuszoo-about__step-number" aria-hidden="true">0{{ index }}</span>
            <h3>{{ section.settings[heading_key] | escape }}</h3>
            <p>{{ section.settings[text_key] | escape }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>

  <section class="cuszoo-about__section cuszoo-about__connections" aria-labelledby="CuszooAboutConnections-{{ section.id }}">
    <div class="page-width cuszoo-about__inner">
      <div class="cuszoo-about__section-header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.connections_eyebrow != blank -%}
          <p class="cuszoo-about__eyebrow">{{ section.settings.connections_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="CuszooAboutConnections-{{ section.id }}" class="cuszoo-about__heading">{{ section.settings.connections_heading }}</h2>
        {%- if section.settings.connections_text != blank -%}
          <p class="cuszoo-about__intro">{{ section.settings.connections_text | escape }}</p>
        {%- endif -%}
      </div>
      <div class="cuszoo-about__connection-grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'connection' -%}
            <article class="cuszoo-about__connection{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" role="listitem" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="cuszoo-about__connection-link focus-inset">
                <div class="cuszoo-about__connection-media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 900
                      | image_tag:
                        widths: '350, 500, 700, 900',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 86vw',
                        loading: 'lazy',
                        alt: block.settings.image_alt
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="cuszoo-about__connection-copy">
                  <h3>{{ block.settings.heading | escape }}</h3>
                  <p>{{ block.settings.text | escape }}</p>
                  <span class="cuszoo-about__connection-action">
                    {{ block.settings.link_label | escape }}
                    <span class="material-icons-round" aria-hidden="true">arrow_forward</span>
                  </span>
                </div>
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="cuszoo-about__section cuszoo-about__commitments" aria-labelledby="CuszooAboutCommitments-{{ section.id }}">
    <div class="page-width cuszoo-about__inner cuszoo-about__commitments-inner">
      <div class="cuszoo-about__commitments-heading{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.commitments_eyebrow != blank -%}
          <p class="cuszoo-about__eyebrow cuszoo-about__eyebrow--light">{{ section.settings.commitments_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="CuszooAboutCommitments-{{ section.id }}" class="cuszoo-about__heading">{{ section.settings.commitments_heading }}</h2>
      </div>
      <div class="cuszoo-about__commitment-list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'commitment' -%}
            <div class="cuszoo-about__commitment{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" role="listitem" {{ block.shopify_attributes }}>
              {%- render 'material-icon', custom_icon: block.settings.icon, class: 'cuszoo-about__commitment-icon' -%}
              <div>
                <h3>{{ block.settings.heading | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="cuszoo-about__final" aria-labelledby="CuszooAboutFinal-{{ section.id }}">
    <div class="cuszoo-about__final-media">
      {%- if final_image != blank -%}
        {{
          final_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: section.settings.final_image_alt
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="cuszoo-about__final-shade" aria-hidden="true"></div>
    <div class="page-width cuszoo-about__final-inner">
      <div class="cuszoo-about__final-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <h2 id="CuszooAboutFinal-{{ section.id }}">{{ section.settings.final_heading }}</h2>
        {%- if section.settings.final_text != blank -%}
          <p>{{ section.settings.final_text | escape }}</p>
        {%- endif -%}
        <div class="cuszoo-about__final-actions">
          {%- if section.settings.final_button_label != blank -%}
            <a class="button button--primary" href="{{ section.settings.final_button_link | default: routes.all_products_collection_url }}">
              {{ section.settings.final_button_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.final_secondary_label != blank -%}
            <a class="cuszoo-about__text-link" href="{{ section.settings.final_secondary_link | default: routes.root_url }}">
              {{ section.settings.final_secondary_label | escape }}
              <span class="material-icons-round" aria-hidden="true">arrow_forward</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Cuszoo About Us",
  "tag": "section",
  "class": "section section--cuszoo-about",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "页面配色", "default": "scheme-1" },
    { "type": "header", "content": "首屏" },
    { "type": "image_picker", "id": "hero_image", "label": "桌面首屏图片" },
    { "type": "image_picker", "id": "hero_image_mobile", "label": "手机首屏图片" },
    { "type": "text", "id": "hero_image_alt", "label": "首屏图片替代文字", "default": "A personalized Cuszoo gift made from a meaningful memory" },
    { "type": "text", "id": "hero_eyebrow", "label": "首屏小标题", "default": "ABOUT CUSZOO" },
    { "type": "inline_richtext", "id": "hero_heading", "label": "首屏标题", "default": "Made Personal. Kept Forever." },
    { "type": "richtext", "id": "hero_text", "label": "首屏介绍", "default": "<p>We turn the people, pets, and moments you love into gifts made to feel unmistakably yours.</p>" },
    { "type": "text", "id": "hero_button_label", "label": "首屏按钮文字", "default": "Explore Personalized Gifts" },
    { "type": "url", "id": "hero_button_link", "label": "首屏按钮链接" },
    { "type": "header", "content": "品牌故事" },
    { "type": "text", "id": "story_eyebrow", "label": "故事小标题", "default": "OUR STORY" },
    { "type": "inline_richtext", "id": "story_heading", "label": "故事标题", "default": "Small Details. Big Meaning." },
    { "type": "richtext", "id": "story_text", "label": "故事正文", "default": "<p>The best gifts begin with something real: a favorite photo, a familiar name, or a moment you never want to lose.</p><p>At Cuszoo, we help turn those details into personal keepsakes made for celebrating, remembering, and staying connected.</p>" },
    { "type": "image_picker", "id": "story_image_primary", "label": "故事主图片" },
    { "type": "text", "id": "story_image_primary_alt", "label": "故事主图片替代文字", "default": "A meaningful personalized gift displayed at home" },
    { "type": "image_picker", "id": "story_image_secondary", "label": "故事副图片" },
    { "type": "text", "id": "story_image_secondary_alt", "label": "故事副图片替代文字", "default": "A close view of a personalized Cuszoo keepsake" },
    { "type": "header", "content": "制作过程" },
    { "type": "text", "id": "process_eyebrow", "label": "流程小标题", "default": "FROM MEMORY TO GIFT" },
    { "type": "inline_richtext", "id": "process_heading", "label": "流程标题", "default": "Your Story, Made Tangible" },
    { "type": "text", "id": "process_text", "label": "流程介绍", "default": "A few personal details are all it takes to begin." },
    { "type": "text", "id": "step_1_heading", "label": "第 1 步标题", "default": "Start With Your Story" },
    { "type": "textarea", "id": "step_1_text", "label": "第 1 步文字", "default": "Choose a photo, name, message, or meaningful detail." },
    { "type": "text", "id": "step_2_heading", "label": "第 2 步标题", "default": "Make It Personal" },
    { "type": "textarea", "id": "step_2_text", "label": "第 2 步文字", "default": "Customize the design and preview something created around you." },
    { "type": "text", "id": "step_3_heading", "label": "第 3 步标题", "default": "Keep the Moment Close" },
    { "type": "textarea", "id": "step_3_text", "label": "第 3 步文字", "default": "Receive a gift made for giving, displaying, wearing, or remembering." },
    { "type": "header", "content": "关系分类" },
    { "type": "text", "id": "connections_eyebrow", "label": "分类小标题", "default": "MADE FOR WHAT MATTERS" },
    { "type": "inline_richtext", "id": "connections_heading", "label": "分类标题", "default": "For Every Meaningful Connection" },
    { "type": "text", "id": "connections_text", "label": "分类介绍", "default": "Find something personal for the relationships and memories closest to you." },
    { "type": "header", "content": "品牌承诺" },
    { "type": "text", "id": "commitments_eyebrow", "label": "承诺小标题", "default": "THE CUSZOO PROMISE" },
    { "type": "inline_richtext", "id": "commitments_heading", "label": "承诺标题", "default": "Thoughtful From Start to Finish" },
    { "type": "header", "content": "底部行动区" },
    { "type": "image_picker", "id": "final_image", "label": "底部背景图片" },
    { "type": "text", "id": "final_image_alt", "label": "底部图片替代文字", "default": "A personal gift celebrating a favorite moment" },
    { "type": "inline_richtext", "id": "final_heading", "label": "底部标题", "default": "Your Favorite Moment Already Means Everything." },
    { "type": "text", "id": "final_text", "label": "底部文字", "default": "Let’s make it something you can keep." },
    { "type": "text", "id": "final_button_label", "label": "主按钮文字", "default": "Find Your Gift" },
    { "type": "url", "id": "final_button_link", "label": "主按钮链接" },
    { "type": "text", "id": "final_secondary_label", "label": "次要链接文字", "default": "Need help? Contact us" },
    { "type": "url", "id": "final_secondary_link", "label": "次要链接" }
  ],
  "blocks": [
    {
      "type": "connection",
      "name": "关系分类",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "image_alt", "label": "图片替代文字" },
        { "type": "text", "id": "heading", "label": "标题", "default": "For the Pets We Love" },
        { "type": "textarea", "id": "text", "label": "文字", "default": "Personal gifts celebrating the bond that makes every day brighter." },
        { "type": "text", "id": "link_label", "label": "链接文字", "default": "Explore gifts" },
        { "type": "url", "id": "link", "label": "链接" }
      ]
    },
    {
      "type": "commitment",
      "name": "品牌承诺",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "icon", "label": "Google 图标名称", "default": "volunteer_activism" },
        { "type": "text", "id": "heading", "label": "标题", "default": "Meaningful by Design" },
        { "type": "textarea", "id": "text", "label": "文字", "default": "Personal details are part of the design, not an afterthought." }
      ]
    }
  ],
  "max_blocks": 7
}
{% endschema %}
