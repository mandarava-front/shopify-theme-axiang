{{ 'judge-me-custom.css' | asset_url | stylesheet_tag }}

<section class="jdgm-all-reviews-page color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <h1 class="jdgm-all-reviews-page__heading">{{ section.settings.heading | escape }}</h1>
    <!-- Judge.me supplies the genuine store-wide review content in these metafields. -->
    {{ shop.metafields.judgeme.all_reviews_header }}
    <div class="jdgm-widget jdgm-all-reviews-widget" data-auto-install="false">
      {{ shop.metafields.judgeme.all_reviews_widget }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Judge.me 店铺总评论",
  "settings": [
    { "type": "text", "id": "heading", "label": "页面标题", "default": "Customer Reviews" },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Judge.me 店铺总评论" }]
}
{% endschema %}
