{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'cuszoo-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cuszoo-visual-links.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign scroll_mode = section.settings.scroll_mode | default: 'grid'
  assign continuous_scroll = false
  if scroll_mode == 'continuous' and section.blocks.size > 1
    assign continuous_scroll = true
  endif

  assign show_mobile_slider = false
  if scroll_mode == 'buttons' and section.blocks.size > 2
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if scroll_mode == 'buttons' and section.blocks.size > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif

  case section.settings.image_ratio
    when 'portrait'
      assign ratio_percent = 125
    when 'landscape'
      assign ratio_percent = 75
    else
      assign ratio_percent = 100
  endcase
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #Slider-{{ section.id }} .cuszoo-visual-link__media {
    --visual-link-ratio: {{ ratio_percent }}%;
  }

  #shopify-section-{{ section.id }} .cuszoo-visual-links-section {
    --visual-links-background: {{ section.settings.background | default: '#fbf6ef' }};
    --visual-link-button-width: {{ section.settings.button_width }}px;
  }

  #shopify-section-{{ section.id }} {
    margin-top: 0;
    background: rgb(var(--color-background));
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} cuszoo-visual-links-section{% if section.settings.title contains 'Who Are You' %} cuszoo-visual-links-section--recipient{% endif %}">
  <div class="page-width section-{{ section.id }}-padding cuszoo-visual-links cuszoo-visual-links--{{ section.settings.display_style }} cuszoo-visual-links--button-width-{{ section.settings.button_width_mode }}{% if section.settings.title contains 'Who Are You' %} cuszoo-visual-links--two-column-mobile{% endif %}">
    {%- if section.settings.title != blank -%}
      <h2 class="cuszoo-section-heading inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="cuszoo-section-subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <cuszoo-visual-links
      data-scroll-mode="{{ scroll_mode }}"
      data-scroll-speed="{{ section.settings.continuous_speed }}"
    >
    <slider-component>
      <ul
        id="Slider-{{ section.id }}"
        class="cuszoo-visual-links__grid grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--2-col-tablet-down{% if show_mobile_slider or show_desktop_slider or continuous_scroll %} slider{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek cuszoo-slider--peek{% endif %}{% if show_desktop_slider %} slider--desktop{% endif %}{% if continuous_scroll %} cuszoo-visual-links__grid--continuous{% endif %}"
        role="list"
        aria-label="{{ section.settings.title | escape }}"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_collection = block.settings.collection
            assign block_image = block.settings.image
            assign block_asset_image = block.settings.asset_image
            assign block_external_image = block.settings.external_image_url
            assign block_title = block.settings.title | default: block_collection.title | default: 'Collection'
            assign block_link = block.settings.link | default: block_collection.url | default: routes.collections_url
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="grid__item{% if show_mobile_slider or show_desktop_slider or continuous_scroll %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <a class="cuszoo-visual-link focus-inset" href="{{ block_link }}">
              <div class="cuszoo-visual-link__media">
                {%- if block_image != blank -%}
                  {{
                    block_image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '165, 360, 533, 720, 940, 1200',
                      sizes: '(min-width: 990px) calc((100vw - 10rem) / 6), 45vw',
                      loading: 'lazy',
                      alt: block_title
                  }}
                {%- elsif block_asset_image != blank -%}
                  <img
                    src="{{ block_asset_image | asset_url }}"
                    alt="{{ block_title | escape }}"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                {%- elsif block_collection.featured_image != blank -%}
                  {{
                    block_collection.featured_image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '165, 360, 533, 720, 940, 1200',
                      sizes: '(min-width: 990px) calc((100vw - 10rem) / 6), 45vw',
                      loading: 'lazy',
                      alt: block_title
                  }}
                {%- elsif block_external_image != blank -%}
                  <img
                    src="{{ block_external_image }}"
                    alt="{{ block_title | escape }}"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              {%- if block.settings.eyebrow != blank -%}
                <span class="cuszoo-visual-link__eyebrow">{{ block.settings.eyebrow | escape }}</span>
              {%- endif -%}
              <span class="cuszoo-visual-link__title">{{ block_title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons cuszoo-visual-links__controls">
          <button type="button" class="slider-button slider-button--prev{% unless section.settings.show_slider_buttons %} visually-hidden{% endunless %}" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button type="button" class="slider-button slider-button--next{% unless section.settings.show_slider_buttons %} visually-hidden{% endunless %}" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
    </cuszoo-visual-links>
  </div>
</div>

{% schema %}
{
  "name": "可视链接网格",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "标题", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "副标题" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "标题大小",
      "options": [
        { "value": "h2", "label": "小" },
        { "value": "h1", "label": "中" },
        { "value": "h0", "label": "大" }
      ],
      "default": "h2"
    },
    { "type": "range", "id": "columns_desktop", "label": "电脑端每行数量", "min": 2, "max": 6, "step": 1, "default": 6 },
    {
      "type": "select",
      "id": "scroll_mode",
      "label": "展示和滚动方式",
      "options": [
        { "value": "grid", "label": "平铺网格" },
        { "value": "buttons", "label": "左右按钮切换" },
        { "value": "continuous", "label": "连续循环滚动" }
      ],
      "default": "grid"
    },
    { "type": "checkbox", "id": "show_slider_buttons", "label": "显示左右箭头按钮", "default": true },
    { "type": "range", "id": "continuous_speed", "label": "连续滚动速度", "min": 10, "max": 80, "step": 5, "default": 30 },
    {
      "type": "select",
      "id": "display_style",
      "label": "外观样式",
      "options": [
        { "value": "cards", "label": "图片卡片" },
        { "value": "circles", "label": "圆形图片" },
        { "value": "buttons", "label": "文字按钮" }
      ],
      "default": "cards"
    },
    {
      "type": "select",
      "id": "button_width_mode",
      "label": "文字按钮宽度方式",
      "options": [
        { "value": "auto", "label": "按文字长度自适应" },
        { "value": "custom", "label": "使用自定义宽度" }
      ],
      "default": "auto"
    },
    { "type": "range", "id": "button_width", "label": "文字按钮宽度", "min": 100, "max": 400, "step": 10, "unit": "px", "default": 220 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "图片比例",
      "options": [
        { "value": "square", "label": "正方形" },
        { "value": "portrait", "label": "竖图" },
        { "value": "landscape", "label": "横图" }
      ],
      "default": "square"
    },
    { "type": "color", "id": "background", "label": "模块背景颜色", "default": "#fbf6ef" },
    { "type": "color_scheme", "id": "color_scheme", "label": "文字配色方案", "default": "scheme-1" },
    { "type": "header", "content": "模块间距" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "上边距", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "下边距", "default": 24 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "可视链接",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "asset_image", "label": "主题图片文件名（assets 内，可选）" },
        { "type": "url", "id": "external_image_url", "label": "外部图片链接" },
        { "type": "collection", "id": "collection", "label": "产品系列" },
        { "type": "text", "id": "title", "label": "自定义标题" },
        { "type": "url", "id": "link", "label": "自定义链接" },
        { "type": "text", "id": "eyebrow", "label": "小标签" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "可视链接网格",
      "blocks": [
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" },
        { "type": "link" }
      ]
    }
  ]
}
{% endschema %}
