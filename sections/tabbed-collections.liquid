{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'cuszoo-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cuszoo-collection-tabs.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.quick_add == 'standard' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} .cuszoo-tabs__list {
    --tabs-per-row: {{ section.settings.tabs_per_row }};
    --tabs-row-gap: {{ section.settings.tabs_per_row | minus: 1 | times: 0.8 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cuszoo-tabs__list {
      --tabs-per-row: {{ section.settings.tabs_per_row_mobile }};
      --tabs-row-gap: {{ section.settings.tabs_per_row_mobile | minus: 1 | times: 0.8 }}rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <cuszoo-collection-tabs class="page-width section-{{ section.id }}-padding">
    {%- assign initial_collection = section.blocks.first.settings.collection -%}
    <div class="cuszoo-tabs__campaign" style="--campaign-tabs-background: {{ section.settings.background }};">
      <div class="cuszoo-tabs__campaign-media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '550, 750, 1000, 1300, 1600',
              sizes: '(min-width: 750px) 42vw, 100vw',
              loading: 'lazy',
              alt: section.settings.title
          }}
        {%- elsif section.settings.external_image_url != blank -%}
          <img
            src="{{ section.settings.external_image_url }}"
            alt="{{ section.settings.title | escape }}"
            width="1600"
            height="960"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="cuszoo-tabs__campaign-content">
        {%- if section.settings.title != blank -%}
          <h2 class="inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p>{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}

        <div class="cuszoo-tabs__actions">
          <div class="cuszoo-tabs__list cuszoo-tabs__list--{{ section.settings.tab_wrap_mode }}" role="tablist" aria-label="{{ section.settings.title | escape }}">
            {%- for block in section.blocks -%}
              {%- assign tab_label = block.settings.label | default: block.settings.collection.title | default: 'Collection' -%}
              <button
                class="cuszoo-tabs__tab"
                id="Tab-{{ section.id }}-{{ forloop.index }}"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="Panel-{{ section.id }}-{{ forloop.index }}"
                data-collection-url="{{ block.settings.collection.url | default: routes.all_products_collection_url }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="svg-wrapper cuszoo-tabs__check" aria-hidden="true">
                  {{- 'icon-checkmark.svg' | inline_asset_content -}}
                </span>
                {{ tab_label | escape }}
              </button>
            {%- endfor -%}
          </div>

          <a
            class="cuszoo-tabs__see-all"
            href="{{ initial_collection.url | default: routes.all_products_collection_url }}"
            data-cuszoo-tabs-see-all
          >
            {{ section.settings.see_all_label | escape }}
            <span class="svg-wrapper" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </a>
        </div>
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign tab_collection = block.settings.collection
        assign product_limit = block.settings.products_to_show
        assign products_to_display = tab_collection.products.size | at_most: product_limit
        if tab_collection.products.size == 0
          assign products_to_display = product_limit
        endif
        assign show_tab_slider = false
        if section.settings.mobile_layout == 'slider' and products_to_display > 2
          assign show_tab_slider = true
        endif
        assign tab_index = forloop.index
      -%}
      <div
        class="cuszoo-tabs__panel"
        id="Panel-{{ section.id }}-{{ forloop.index }}"
        role="tabpanel"
        aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <slider-component>
          <ul
            id="Slider-{{ section.id }}-{{ forloop.index }}"
            class="grid product-grid contains-card contains-card--product grid--{{ section.settings.columns_desktop }}-col-desktop grid--2-col-tablet-down cuszoo-mobile-products{% if show_tab_slider %} slider slider--tablet grid--peek cuszoo-mobile-products--slider{% else %} cuszoo-mobile-products--grid{% endif %}"
            role="list"
            aria-label="{{ block.settings.label | default: tab_collection.title | escape }}"
          >
            {%- if tab_collection.products.size > 0 -%}
              {%- for product in tab_collection.products limit: product_limit -%}
                <li
                  id="Slide-{{ section.id }}-{{ tab_index }}-{{ forloop.index }}"
                  class="grid__item{% if show_tab_slider %} slider__slide{% endif %}"
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: 'default',
                    lazy_load: true,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    section_id: block.id,
                    quick_add: section.settings.quick_add,
                    product_view_context: 'collection'
                  %}
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..products_to_display) -%}
                <li
                  id="Slide-{{ section.id }}-{{ tab_index }}-{{ forloop.index }}"
                  class="grid__item{% if show_tab_slider %} slider__slide{% endif %}"
                >
                  {%- assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                  {%- assign placeholder_image = 'product-apparel-' | append: placeholder_index -%}
                  {% render 'card-product', media_aspect_ratio: section.settings.image_ratio, placeholder_image: placeholder_image %}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>

          {%- if show_tab_slider -%}
            <div class="slider-buttons">
              <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}-{{ forloop.index }}">
                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </button>
              <div class="slider-counter caption">
                <span class="slider-counter--current">1</span>
                <span aria-hidden="true"> / </span>
                <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                <span class="slider-counter--total">{{ products_to_display }}</span>
              </div>
              <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}-{{ forloop.index }}">
                <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
              </button>
            </div>
          {%- endif -%}
        </slider-component>

        {%- if section.settings.show_view_all and tab_collection != blank -%}
          <div class="cuszoo-tabs__view-all">
            <a class="button button--secondary" href="{{ tab_collection.url }}">
              {{ section.settings.view_all_label | escape }}
              <span class="svg-wrapper" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </cuszoo-collection-tabs>
</div>

{% schema %}
{
  "name": "选项卡产品系列",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "活动图片（推荐 1200 × 1200px）" },
    { "type": "url", "id": "external_image_url", "label": "外部活动图片链接" },
    { "type": "inline_richtext", "id": "title", "label": "标题", "default": "Curated choices" },
    { "type": "text", "id": "subtitle", "label": "副标题", "default": "Thoughtful picks for every occasion." },
    { "type": "color", "id": "background", "label": "活动区域背景", "default": "#f7e7d2" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "标题大小",
      "options": [
        { "value": "h2", "label": "小" },
        { "value": "h1", "label": "中" },
        { "value": "h0", "label": "大" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "see_all_label", "label": "顶部链接文字", "default": "See all" },
    { "type": "text", "id": "view_all_label", "label": "底部链接文字", "default": "View More" },
    {
      "type": "select",
      "id": "tab_wrap_mode",
      "label": "选项换行方式",
      "options": [
        { "value": "whole", "label": "整颗选项换到下一行" },
        { "value": "inside", "label": "选项内文字换行" }
      ],
      "default": "inside"
    },
    { "type": "range", "id": "tabs_per_row", "label": "电脑端每行选项数量", "min": 1, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "tabs_per_row_mobile",
      "label": "手机端每行选项数量",
      "options": [
        { "value": "1", "label": "1 个" },
        { "value": "2", "label": "2 个" }
      ],
      "default": "1"
    },
    { "type": "range", "id": "columns_desktop", "label": "电脑端每行产品数量", "min": 2, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "手机端产品布局",
      "options": [
        { "value": "grid_2", "label": "双列网格" },
        { "value": "slider", "label": "横向滑动" }
      ],
      "default": "grid_2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "产品图片比例",
      "options": [
        { "value": "adapt", "label": "适应图片" },
        { "value": "portrait", "label": "竖图" },
        { "value": "square", "label": "正方形" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "悬停时显示第二张图片", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "显示供应商", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "显示评分", "default": true },
    {
      "type": "select",
      "id": "quick_add",
      "label": "快速添加",
      "options": [
        { "value": "none", "label": "无" },
        { "value": "standard", "label": "标准" }
      ],
      "default": "none"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "显示查看全部按钮", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "scheme-1" },
    { "type": "header", "content": "模块间距" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "上边距", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "下边距", "default": 24 }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "产品系列选项",
      "settings": [
        { "type": "text", "id": "label", "label": "选项文字" },
        { "type": "collection", "id": "collection", "label": "产品系列" },
        { "type": "range", "id": "products_to_show", "label": "显示产品数量", "min": 2, "max": 12, "step": 1, "default": 8 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "选项卡产品系列",
      "blocks": [
        { "type": "collection_tab", "settings": { "label": "热销产品" } },
        { "type": "collection_tab", "settings": { "label": "新品上架" } },
        { "type": "collection_tab", "settings": { "label": "礼物灵感" } }
      ]
    }
  ]
}
{% endschema %}
