{%- style -%}
  .cuszoo-faq { padding: 3.2rem 0 5.6rem; }
  .cuszoo-faq__heading { margin: 0 0 3.2rem; text-align: center; }
  .cuszoo-faq__category { margin: 2.8rem 0 1rem; font-size: 2.2rem; font-weight: 800; line-height: 1.25; }
  .cuszoo-faq__item { border-bottom: 0.1rem solid rgba(var(--color-foreground), .16); }
  .cuszoo-faq__item summary { min-height: 5.2rem; padding: 1.4rem 3.2rem 1.4rem 0; font-size: 2.2rem; font-weight: 600; cursor: pointer; }
  .cuszoo-faq__answer { padding: 0 0 1.6rem; font-size: 1.6rem; line-height: 1.6; }
  @media screen and (max-width: 749px) {
    .cuszoo-faq { padding: 2.4rem 1.5rem 4rem; }
    .cuszoo-faq__heading { margin-bottom: 2.4rem; font-size: 2.8rem; }
    .cuszoo-faq__category { margin-top: 2.4rem; font-size: 2rem; }
    .cuszoo-faq__item summary { min-height: 5.6rem; padding: 1.5rem 3.2rem 1.5rem 0; font-size: 1.8rem; line-height: 1.35; }
    .cuszoo-faq__answer { font-size: 1.6rem; }
  }
{%- endstyle -%}

<section class="cuszoo-faq color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h1 class="cuszoo-faq__heading">{{ section.settings.heading | escape }}</h1>{%- endif -%}
    <div class="cuszoo-faq__list">
      {%- assign previous_category = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.category != blank and block.settings.category != previous_category -%}
          <h2 class="cuszoo-faq__category" {{ block.shopify_attributes }}>{{ block.settings.category | escape }}</h2>
          {%- assign previous_category = block.settings.category -%}
        {%- endif -%}
        <details class="cuszoo-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}{{- 'icon-caret.svg' | inline_asset_content -}}</summary>
          <div class="cuszoo-faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "页面标题", "default": "FAQ" },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ 条目",
      "settings": [
        { "type": "text", "id": "category", "label": "分类标题", "default": "Personalization" },
        { "type": "text", "id": "question", "label": "问题", "default": "How do I personalize a product?" },
        { "type": "richtext", "id": "answer", "label": "回答", "default": "<p>Add your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [{ "type": "faq" }] }
  ]
}
{% endschema %}
